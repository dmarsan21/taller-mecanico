---
const testimonials = [
  {
    quote: "En la agencia me cobraban el triple por cambiar todo el compresor. En Torque hicieron la prueba de fuga UV en 20 minutos, era solo una válvula de carga. Totalmente honestos.",
    name: "Lic. Rodrigo Morales",
    vehicle: "BMW Serie 3 330i",
    avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&h=120&q=80"
  },
  {
    quote: "Lo que más valoro es que me enviaron videos en WhatsApp de los inyectores antes y después del ultrasonido, y me entregaron las bujías viejas en su caja. Nunca había visto esa transparencia.",
    name: "Dra. Gabriela Campos",
    vehicle: "Audi Q5 Quattro",
    avatar: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=120&h=120&q=80"
  },
  {
    quote: "Servicio de frenos y suspensión impecable. Eliminaron por completo un chillido que ningún otro taller pudo quitar. Me dieron póliza de garantía por escrito de 12 meses.",
    name: "Ing. Carlos Valenzuela",
    vehicle: "Mazda CX-5 Turbo",
    avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=120&h=120&q=80"
  }
];
---

<!-- TESTIMONIOS Y PRUEBA SOCIAL -->
<section class="py-16 sm:py-24 bg-zinc-100/70 border-t border-zinc-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-xs uppercase tracking-widest text-amber-600 font-bold block mb-2 font-mono">
        / EXPERIENCIAS REALES /
      </span>
      <h2 class="text-2xl sm:text-4xl font-black text-zinc-900">
        Opiniones de dueños que cuidan su inversión
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
      {testimonials.map((review) => (
        <div class="p-8 rounded-3xl bg-white border border-zinc-200/80 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-1 text-amber-500 mb-4">
              {Array.from({ length: 5 }).map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <p class="text-sm text-zinc-700 leading-relaxed mb-6 font-normal">
              "{review.quote}"
            </p>
          </div>
          <div class="flex items-center justify-between border-t border-zinc-100 pt-4">
            <div class="flex items-center gap-3">
              <img
                src={review.avatar}
                alt={review.name}
                class="w-10 h-10 rounded-full object-cover ring-2 ring-zinc-200/80 shadow-xs shrink-0"
                loading="lazy"
              />
              <div>
                <span class="text-sm font-bold text-zinc-900 block">{review.name}</span>
                <span class="text-xs text-zinc-500">{review.vehicle}</span>
              </div>
            </div>
            <span class="inline-flex items-center gap-1.5 text-[11px] text-emerald-700 font-bold px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200 shrink-0">
              <svg class="w-3.5 h-3.5 text-emerald-600 stroke-[3]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span>Verificado</span>
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
