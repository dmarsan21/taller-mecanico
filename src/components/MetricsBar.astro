<!-- BARRA DE MÉTRICAS Y GARANTÍAS (LIGHT MODE INDUSTRIAL CLEAN) -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-20 sm:mb-24">
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
    
    <div class="p-6 rounded-2xl bg-white border border-zinc-200/80 shadow-sm hover:shadow-md hover:border-zinc-300 transition-all">
      <div class="flex items-center gap-3 mb-2.5">
        <div class="w-9 h-9 rounded-xl bg-amber-50 border border-amber-200/80 text-amber-700 flex items-center justify-center">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
        </div>
        <span class="text-xs font-bold uppercase tracking-wider text-amber-700">Diagnóstico en 35 Min</span>
      </div>
      <p class="text-base font-bold text-zinc-900">Escáner OEM Multimarca</p>
      <p class="text-xs text-zinc-500 mt-1">Lectura profunda de códigos y sensores sin desmontar.</p>
    </div>

    <div class="p-6 rounded-2xl bg-white border border-zinc-200/80 shadow-sm hover:shadow-md hover:border-zinc-300 transition-all">
      <div class="flex items-center gap-3 mb-2.5">
        <div class="w-9 h-9 rounded-xl bg-emerald-50 border border-emerald-200/80 text-emerald-700 flex items-center justify-center">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
            <path d="m9 12 2 2 4-4" />
          </svg>
        </div>
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-700">Cero Sorpresas</span>
      </div>
      <p class="text-base font-bold text-zinc-900">Presupuesto 100% Blindado</p>
      <p class="text-xs text-zinc-500 mt-1">Ningún trabajo inicia sin tu autorización por escrito.</p>
    </div>

    <div class="p-6 rounded-2xl bg-white border border-zinc-200/80 shadow-sm hover:shadow-md hover:border-zinc-300 transition-all">
      <div class="flex items-center gap-3 mb-2.5">
        <div class="w-9 h-9 rounded-xl bg-blue-50 border border-blue-200/80 text-blue-700 flex items-center justify-center">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2" />
            <path d="m9 12 2 2 4-4" />
          </svg>
        </div>
        <span class="text-xs font-bold uppercase tracking-wider text-blue-700">Garantía Escrita</span>
      </div>
      <p class="text-base font-bold text-zinc-900">12 Meses o 20,000 km</p>
      <p class="text-xs text-zinc-500 mt-1">Póliza física y digital en refacciones y mano de obra.</p>
    </div>

    <div class="p-6 rounded-2xl bg-white border border-zinc-200/80 shadow-sm hover:shadow-md hover:border-zinc-300 transition-all">
      <div class="flex items-center gap-3 mb-2.5">
        <div class="w-9 h-9 rounded-xl bg-purple-50 border border-purple-200/80 text-purple-700 flex items-center justify-center">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
            <polyline points="3.29 7 12 12 20.71 7" />
            <line x1="12" x2="12" y1="22" y2="12" />
          </svg>
        </div>
        <span class="text-xs font-bold uppercase tracking-wider text-purple-700">Transparencia Total</span>
      </div>
      <p class="text-base font-bold text-zinc-900">Piezas Viejas en Mano</p>
      <p class="text-xs text-zinc-500 mt-1">Te devolvemos cada componente reemplazado en su caja.</p>
    </div>

  </div>
</section>
